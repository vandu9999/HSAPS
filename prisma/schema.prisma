datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // Hashed password
  name      String?
  role      String   @default("editor") // admin, editor
  createdAt DateTime @default(now())
}

model Doctor {
  id          String   @id @default(cuid())
  name        String
  title       String
  role        String?
  avatar      String
  cchn        String
  clinic      String
  address     String
  specialty   String[]
  education   String[]
  experience  String   @db.Text
  email       String
  phone       String
  isOfficial  Boolean  @default(false)
  joinedYear  Int
  biography   String[]
  createdAt   DateTime @default(now())
}

model Event {
  id              String   @id @default(cuid())
  title           String
  type            String
  date            String
  time            String
  location        String
  imageUrl        String
  description     String   @db.Text
  registrationFee String
  status          String   // upcoming, ongoing, completed
  cmeHours        String
  capacityText    String
  progress        Int      @default(0)
  speakers        String[]
  createdAt       DateTime @default(now())
}

model News {
  id            String   @id @default(cuid())
  imageUrl      String
  category      String
  categoryColor String   // primary, secondary
  date          String
  title         String
  excerpt       String   @db.Text
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model Report {
  id        String   @id @default(cuid())
  title     String
  authors   String[]
  abstract  String   @db.Text
  category  String
  date      String
  journal   String
  imageUrl  String
  tags      String[]
  doi       String
  views     Int      @default(0)
  createdAt DateTime @default(now())
}

model Partner {
  id           String    @id @default(cuid())
  name         String
  category     String    // Kim cương, Vàng, Bạc, Đồng hành
  description  String    @db.Text
  website      String
  phone        String
  email        String
  address      String
  introduction String    @db.Text
  logoType     String?
  logoUrl      String?
  products     Product[]
  createdAt    DateTime  @default(now())
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String   @db.Text
  imageUrl    String
  partnerId   String
  partner     Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
}

model Category {
  id          String   @id @default(cuid())
  type        String   // su-kien, tin-tuc, bao-cao
  name        String
  color       String
  description String?  @db.Text
  createdAt   DateTime @default(now())
}
